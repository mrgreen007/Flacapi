# ==========================================
# FLAC API Server Configuration Example
# ==========================================
# Rename this file to .env to customize local behavior.
# Standard relative and absolute paths are supported.

# 1. Primary Application Data Store
# Houses internal dynamic state, SQLite databases, and temporary download caches.
# Default: ./data
FLACAPI_DATA_DIR=./data

# 2. Extensions Bundle Location
# Directs the server to the folder where SpotiFLAC extension packages (.spotiflac-ext) are kept.
# Default: ./extensions
FLACAPI_EXTENSIONS_DIR=./extensions

# 3. Global Downloads Target Output
# The canonical target folder where your finished high-quality audio files are written.
# When defined, all user downloads default into this clean directory.
# Default: ./downloads
FLACAPI_DOWNLOADS_DIR=./downloads

# 4. Post-Download Media Finalization Strategy
# Controls behavior when the backend returns native containers like .m4a (ALAC).
# Options:
#   ORIGINAL   - (Default) Deliver raw native bytes perfectly preserved from source.
#   FORCE_FLAC - Passively invokes FFmpeg to convert ALL incoming lossy/lossless to .flac containers.
FLACAPI_CONVERSION_STRATEGY=ORIGINAL

# 5. Provider Fallback Sequencing Override
# Comma-separated array that explicitly dictates the searching hierarchy ordering.
# If not defined, uses established master fallback fallback sequence.
# Example: qobuz-web,apple-music,tidal-web
# FLACAPI_PROVIDER_PRIORITY=apple-music,tidal-web,qobuz-web,deezer,amazon,ytmusic-spotiflac,soundcloud,pandora

# -----------------------------------------------------------------------------
# Dynamic Configuration & Extension Store (Optional)
# -----------------------------------------------------------------------------

# Automatically synchronize extensions with the central community repository on startup.
# This periodically refreshes bundled decryption tokens and third-party download mirrors
# implicitly. Set to 'false' to lock down current installed versions absolutely.
# FLACAPI_AUTO_UPDATE_EXTENSIONS=true

# Point the internal engine to an alternate repository hosting your specific extensions.
# Supports BOTH Git repo links (e.g. github.com/owner/repo) and direct raw JSON HTTP links.
# FLACAPI_EXTENSION_STORE_URL=https://github.com/spotiflacapp/SpotiFLAC-Extension

# -----------------------------------------------------------------------------
# Manual Override Directives (Power Users Only)
# -----------------------------------------------------------------------------
# These are usually UNNECESSARY thanks to the Auto-Updater above.
# Supply these ONLY if you wish to hard-override standard mirrors with your own
# private proxy endpoints or custom tokens.
# FLACAPI_TIDAL_MIRROR_URL=https://api.example.com/v1/dl/tid2
# FLACAPI_TIDAL_TOKEN=YOUR_CUSTOM_PUBLIC_TOKEN
# FLACAPI_APPLE_PROXY_KEY=YOUR_APPLE_PROXY_AUTHORIZATION_KEY
